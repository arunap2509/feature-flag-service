FROM golang:alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY cmd/ cmd/
COPY internal/ internal/

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/mgmt-api ./cmd/mgmt-api

FROM alpine:3.20

RUN apk --no-cache add ca-certificates curl

WORKDIR /app
COPY --from=builder /app/mgmt-api /app/mgmt-api

EXPOSE 8081

ENTRYPOINT ["/app/mgmt-api"]
